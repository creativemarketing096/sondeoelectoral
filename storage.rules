rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Fotos de candidatos: se ven públicas en las tarjetas, solo el admin las sube.
    match /candidatos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Foto de verificación del participante: la sube cualquiera al votar,
    // pero solo el admin (dashboard antifraude) puede verla.
    match /verificacion/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if true;
    }
  }
}
